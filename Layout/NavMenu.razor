<style>
    /* Navbar container */
    .custom-navbar {
        background: linear-gradient(180deg, #052767 0%, #3a0647 70%);
        padding: 0.5rem 0;
        min-height: 100vh;
        width: 250px;
        position: fixed;
        left: 0;
        top: 0;
        bottom: 0;
        z-index: 1000;
        color: white;
    }

    .custom-navbar .brand {
        font-size: 1.5rem;
        font-weight: bold;
        color: white !important;
        padding: 1rem;
        display: block;
        text-decoration: none;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        margin-bottom: 0.5rem;
    }

    .custom-navbar .brand:hover {
        color: white !important;
    }

    .custom-navbar .nav-item {
        padding: 0.25rem 0;
    }

    .custom-navbar .nav-link {
        color: rgba(255, 255, 255, 0.8);
        text-decoration: none;
        padding: 0.75rem 1.5rem;
        display: block;
        transition: all 0.2s;
        font-size: 1.1rem;
    }

    .custom-navbar .nav-link:hover {
        color: white;
        background-color: rgba(255, 255, 255, 0.1);
    }

    .custom-navbar .nav-link.active {
        color: white;
        background-color: rgba(255, 255, 255, 0.2);
        border-left: 4px solid #ffd700;
    }

    .custom-navbar .nav-link .icon {
        margin-right: 0.75rem;
        font-size: 1.2rem;
        display: inline-block;
        width: 30px;
        text-align: center;
    }

    .custom-navbar .nav-link .label {
        display: inline-block;
    }

    /* Mobile toggle */
    .mobile-toggle {
        display: none;
        background: transparent;
        border: 1px solid rgba(255,255,255,0.3);
        border-radius: 0.25rem;
        padding: 0.5rem 1rem;
        color: white;
        cursor: pointer;
        font-size: 1.5rem;
        margin: 0.5rem 1rem;
    }

    /* Mobile styles */
    @@media (max-width: 768px) {
        .custom-navbar {
            width: 100%;
            min-height: auto;
            position: relative;
            height: auto;
        }
        .custom-navbar .brand {
            display: inline-block;
            padding: 0.75rem 1rem;
            border-bottom: none;
            margin-bottom: 0;
        }
        .mobile-toggle {
            display: inline-block;
            float: right;
        }
        .custom-navbar .nav-items {
            display: none;
            clear: both;
            padding-top: 0.5rem;
        }
        .custom-navbar .nav-items.open {
            display: block;
        }
        .custom-navbar .nav-link {
            padding: 0.75rem 1.5rem;
        }
    }
</style>

<div class="custom-navbar">
    <div style="display: flex; justify-content: space-between; align-items: center; padding: 0 1rem;">
        <a class="brand" href="/">🈳 Kanji Learner</a>
        <button class="mobile-toggle" @onclick="ToggleMenu">☰</button>
    </div>
    
    <div class="nav-items @(isMenuOpen ? "open" : "")">
        <div class="nav-item">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                <span class="icon">🏠</span>
                <span class="label">Home</span>
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="/kanjilist">
                <span class="icon">📚</span>
                <span class="label">All Kanji</span>
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="/flashcard">
                <span class="icon">🃏</span>
                <span class="label">Flashcards</span>
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="/quiz">
                <span class="icon">✍️</span>
                <span class="label">Quiz</span>
            </NavLink>
        </div>
    </div>
</div>

@code {
    private bool isMenuOpen = false;

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
    }
}