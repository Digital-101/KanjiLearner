@page "/"
@layout MainLayout
@using KanjiLearner.Services
@inject KanjiService KanjiService

<PageTitle>Kanji Learner - Home</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-12 text-center">
            <h1 class="display-4">🇯🇵 Learn Kyōiku Kanji</h1>
            <p class="lead">Master all 1,026 official elementary school kanji with romaji support</p>
            <hr />
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-4 mb-3">
            <div class="card feature-card">
                <div class="card-body text-center">
                    <h2 class="card-title">📚 All Kanji</h2>
                    <p class="card-text">Browse all 1,026 Kyōiku kanji with detailed information</p>
                    <a href="/kanjilist" class="btn btn-primary">View All</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card feature-card">
                <div class="card-body text-center">
                    <h2 class="card-title">🃏 Flashcards</h2>
                    <p class="card-text">Practice with interactive flashcards</p>
                    <a href="/flashcard" class="btn btn-success">Start Practice</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card feature-card">
                <div class="card-body text-center">
                    <h2 class="card-title">✍️ Quiz</h2>
                    <p class="card-text">Test your knowledge with quizzes</p>
                    <a href="/quiz" class="btn btn-warning">Take Quiz</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3>About Kyōiku Kanji</h3>
                </div>
                <div class="card-body">
                    <p>The <strong>Kyōiku kanji</strong> (教育漢字) are the 1,026 kanji taught in Japanese elementary schools (grades 1-6).</p>
                    <ul>
                        <li><strong>Grade 1:</strong> 80 kanji</li>
                        <li><strong>Grade 2:</strong> 160 kanji</li>
                        <li><strong>Grade 3:</strong> 200 kanji</li>
                        <li><strong>Grade 4:</strong> 202 kanji</li>
                        <li><strong>Grade 5:</strong> 193 kanji</li>
                        <li><strong>Grade 6:</strong> 191 kanji</li>
                    </ul>
                    <p>Total: <strong>1,026 kanji</strong></p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .feature-card {
        transition: transform 0.3s;
        cursor: pointer;
        height: 100%;
    }
    .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
    }
</style>