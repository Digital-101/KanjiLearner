@page "/kanjilist"
@layout MainLayout
@using KanjiLearner.Models
@using KanjiLearner.Services
@inject KanjiService KanjiService

<PageTitle>Kanji Learner - All Kanji</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h2>📚 All Kyōiku Kanji</h2>
            <p>Total: @filteredKanji.Count / 1,026 kanji</p>
            
            <div class="search-box mb-3">
                <input type="text" 
                       class="form-control" 
                       placeholder="Search by character, meaning, or romaji..." 
                       value="@searchTerm"
                       @oninput="OnSearchChanged" />
            </div>

            <div class="grade-filter mb-3">
                <button class="btn @(selectedGrade == 0 ? "btn-primary" : "btn-outline-primary") me-1" 
                        @onclick="() => SetGrade(0)">
                    All
                </button>
                @for (int i = 1; i <= 6; i++)
                {
                    <button class="btn @(selectedGrade == i ? "btn-primary" : "btn-outline-primary") me-1" 
                            @onclick="() => SetGrade(i)">
                        Grade @i
                    </button>
                }
            </div>

            <div class="row">
                @foreach (var kanji in filteredKanji.Take(100))
                {
                    <div class="col-md-3 col-sm-6 mb-3">
                        <div class="card kanji-grid-card" @onclick="() => ShowKanjiDetail(kanji)">
                            <div class="card-body text-center">
                                <div class="kanji-char-display">@kanji.Character</div>
                                <div class="kanji-romaji">@kanji.Romaji</div>
                                <div class="kanji-meaning">@kanji.Meaning</div>
                                <span class="badge bg-secondary">Grade @kanji.Grade</span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (filteredKanji.Count > 100)
            {
                <p class="text-muted">Showing 100 of @filteredKanji.Count kanji</p>
            }
        </div>
    </div>
</div>

<style>
    .kanji-grid-card {
        transition: transform 0.2s;
        cursor: pointer;
    }
    .kanji-grid-card:hover {
        transform: scale(1.05);
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
    }
    .kanji-char-display {
        font-size: 3rem;
        line-height: 1.2;
    }
    .kanji-romaji {
        font-size: 1rem;
        color: #666;
    }
    .kanji-meaning {
        font-size: 0.9rem;
        color: #333;
    }
    .grade-filter .btn {
        margin-right: 5px;
    }
    .search-box {
        max-width: 500px;
    }
</style>

@code {
    private List<Kanji> allKanji = new();
    private List<Kanji> filteredKanji = new();
    private string searchTerm = "";
    private int selectedGrade = 0;

    protected override void OnInitialized()
    {
        try
        {
            allKanji = KanjiService.GetAllKanji();
            filteredKanji = allKanji;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading kanji: {ex.Message}");
            allKanji = new List<Kanji>();
            filteredKanji = new List<Kanji>();
        }
    }

    private void FilterKanji()
    {
        var query = allKanji.AsEnumerable();

        if (selectedGrade > 0)
        {
            query = query.Where(k => k.Grade == selectedGrade);
        }

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query = query.Where(k =>
                k.Character.Contains(searchTerm) ||
                k.Meaning.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                k.Romaji.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
            );
        }

        filteredKanji = query.ToList();
        StateHasChanged();
    }

    private void SetGrade(int grade)
    {
        selectedGrade = grade;
        FilterKanji();
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        FilterKanji();
    }

    private void ShowKanjiDetail(Kanji kanji)
    {
        // You can implement a detail view here
        Console.WriteLine($"Selected: {kanji.Character} - {kanji.Meaning}");
    }
}